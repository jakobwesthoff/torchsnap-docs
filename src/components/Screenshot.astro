---
import { Image } from 'astro:assets';

interface Props {
  dark: ImageMetadata;
  light: ImageMetadata;
  alt: string;
  maxWidth?: string;
}

const { dark, light, alt, maxWidth } = Astro.props;

const darkDisplayWidth = Math.round(dark.width / 2);
const darkDisplayHeight = Math.round(dark.height / 2);
const lightDisplayWidth = Math.round(light.width / 2);
const lightDisplayHeight = Math.round(light.height / 2);
const style = maxWidth ? `max-width: ${maxWidth}` : undefined;
---

<div class="screenshot" {style}>
  <Image src={dark} alt={alt} class="only-dark" width={darkDisplayWidth} height={darkDisplayHeight} densities={[1, 2]} />
  <Image src={light} alt={alt} class="only-light" width={lightDisplayWidth} height={lightDisplayHeight} densities={[1, 2]} />
</div>

<style>
  .screenshot {
    display: grid;
    align-items: start;
    margin-inline: auto;
  }

  .screenshot :global(.only-dark),
  .screenshot :global(.only-light) {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    margin: 0;
    transition: opacity 0.3s ease;
  }

  .screenshot :global(.only-dark) {
    opacity: 0;
  }
  .screenshot :global(.only-light) {
    opacity: 0;
  }
  :global([data-theme="dark"]) .screenshot :global(.only-dark) {
    opacity: 1;
  }
  :global([data-theme="light"]) .screenshot :global(.only-light) {
    opacity: 1;
  }
</style>
